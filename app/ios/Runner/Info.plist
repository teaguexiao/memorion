		<array>
			<string>audio</string>
			<string>bluetooth-central</string>
			<string>fetch</string>
			<string>processing</string>
			<string>remote-notification</string>
		</array>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
		</array>
